# Server-only variables. Never expose these to browser code.
DATABASE_URL=

# Long random secret used to sign legacy access-code sessions.
PORTFOLIO_AUTH_SECRET=

# Optional owner compatibility key. Prefer owner database sessions when available.
PORTFOLIO_ADMIN_KEY=

# M-Pesa/Daraja server-only configuration.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
